.DS_Store
*.pem

# IDE
.idea/

# local env files
.env*.local

# Google Play service-account key (written by CI from a secret; never commit)
playstore-service-account.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Editor / local
.vscode/
graphify-out/

# Icon working files — Expo managed generates app icons from app.json
# (assets/icon.png + android-icon-*.png), so these are not used by the build:
#   assets/android, assets/ios — icon.kitchen/react-native-make slices (bare/prebuild only)
#   assets/play — source art for the Google Play store listing
assets/android/
assets/ios/
assets/play/

# SDD local scratch (progress ledger — never committed)
.superpowers/
docs/superpowers/
google-services.json
