{
  "expo": {
    "name": "HRM Uzgidro",
    "slug": "uzgidro-hrm",
    "version": "2.0.3",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "hrm",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uz.uzgidro.hrm"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "uz.uzgidro.hrm",
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "versionCode": 11
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0085FF",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mehmon rasmini tanlash uchun galereyaga ruxsat bering.",
          "cameraPermission": "Mehmon rasmini va xizmat safaridagi «Keldim» belgisi uchun suratga olishga ruxsat bering."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Ilovani tez ochish uchun Face ID dan foydalanamiz."
        }
      ],
      "expo-image",
      "expo-localization",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Kompyuterdagi QR-kodni skanerlab tizimga kirish uchun kameraga ruxsat bering.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Xizmat safarida «Keldim» belgisi qayerda qo'yilganini davomatga yozish uchun joylashuvingiz kerak."
        }
      ],
      "./plugins/withNetworkSecurity",
      "./plugins/withLegacyStoragePermission"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "url": "https://u.expo.dev/a67e12d1-02d2-4c39-96b1-eb5a465274fc",
      "codeSigningCertificate": "./certs/certificate.pem",
      "codeSigningMetadata": {
        "keyid": "main",
        "alg": "rsa-v1_5-sha256"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a67e12d1-02d2-4c39-96b1-eb5a465274fc"
      }
    },
    "owner": "uzbekgidroenergos-team"
  }
}
